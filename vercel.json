import React, { useEffect, useMemo, useState } from 'react'
import { createRoot } from 'react-dom/client'
import { CalendarDays, LayoutDashboard, LogOut, PawPrint, ShoppingBag, WalletCards, Package, BarChart3, Settings, Plus, Bell, UserRound } from 'lucide-react'
import { hoursFor, isClosed, seatDefs, sessionsFor, todayString } from './lib/config'
import { loadBookings, saveBookings } from './lib/storage'
import './styles.css'

const roles = {
  owner: {label:'老闆', account:'owner', password:'maoyu', pages:['dashboard','reservation','order','checkout','cats','inventory','reports','settings']},
  manager: {label:'店長', account:'manager', password:'maoyu', pages:['dashboard','reservation','order','checkout','cats','inventory']},
  staff: {label:'員工', account:'staff', password:'maoyu', pages:['dashboard','reservation','order','cats']},
}
const navItems = [
  ['dashboard','今日營業',LayoutDashboard], ['reservation','預約與座位',CalendarDays],
  ['order','點餐',ShoppingBag], ['checkout','結帳',WalletCards], ['cats','貓咪',PawPrint],
  ['inventory','庫存',Package], ['reports','報表',BarChart3], ['settings','設定',Settings],
]
const statusText = {booked:'已預約',arrived:'已報到',cancelled:'已取消',noshow:'未到店'}

function Login({onLogin}){
  const [account,setAccount]=useState('owner'); const [password,setPassword]=useState('maoyu'); const [error,setError]=useState('')
  const submit=e=>{e.preventDefault(); const found=Object.entries(roles).find(([,r])=>r.account===account&&r.password===password); if(!found){setError('帳號或密碼錯誤');return}; onLogin({key:found[0],...found[1]})}
  return <div className="login-page"><div className="login-card"><div className="brand-mark"><PawPrint size={34}/></div><p className="eyebrow">貓嶼・慢焙</p><h1>店務系統</h1><p className="muted">登入後依身份顯示可使用功能。</p><form onSubmit={submit}><label>帳號<input value={account} onChange={e=>setAccount(e.target.value)}/></label><label>密碼<input type="password" value={password} onChange={e=>setPassword(e.target.value)}/></label>{error&&<p className="error">{error}</p>}<button className="primary full">登入</button></form><div className="demo"><strong>示範帳號</strong><span>owner / manager / staff</span><span>密碼皆為 maoyu</span></div></div></div>
}

function App(){
 const [user,setUser]=useState(()=>JSON.parse(sessionStorage.getItem('maoyu-user')||'null'))
 const [page,setPage]=useState('dashboard'); const [bookings,setBookings]=useState(loadBookings)
 useEffect(()=>saveBookings(bookings),[bookings]);
 const login=u=>{sessionStorage.setItem('maoyu-user',JSON.stringify(u));setUser(u)}
 const logout=()=>{sessionStorage.removeItem('maoyu-user');setUser(null)}
 if(!user) return <Login onLogin={login}/>
 const available=navItems.filter(([id])=>user.pages.includes(id))
 return <div className="app-shell"><aside><div className="side-brand"><div className="brand-mark small"><PawPrint size={22}/></div><div><strong>貓嶼・慢焙</strong><span>店務系統 v1.0</span></div></div><nav>{available.map(([id,label,Icon])=><button key={id} className={page===id?'active':''} onClick={()=>setPage(id)}><Icon size={19}/><span>{label}</span></button>)}</nav><div className="user-box"><UserRound size={20}/><div><strong>{user.label}</strong><span>{user.account}</span></div><button title="登出" onClick={logout}><LogOut size={18}/></button></div></aside><main><Header user={user}/>{page==='dashboard'&&<Dashboard bookings={bookings} setPage={setPage}/>} {page==='reservation'&&<Reservations bookings={bookings} setBookings={setBookings}/>} {['order','checkout','cats','inventory','reports','settings'].includes(page)&&<ComingSoon page={navItems.find(x=>x[0]===page)?.[1]}/>}</main></div>
}
function Header({user}){return <header><div><p className="eyebrow">營運工作台</p><h2>晚安，{user.label}</h2></div><button className="icon-btn" title="提醒"><Bell size={20}/></button></header>}
function Dashboard({bookings,setPage}){const today=todayString(); const all=bookings.filter(b=>b.date===today); const arrived=all.filter(b=>b.status==='arrived').reduce((n,b)=>n+Number(b.party),0); const noShow=all.filter(b=>b.status==='noshow').reduce((n,b)=>n+Number(b.party),0); const current=all.filter(b=>!['cancelled','noshow'].includes(b.status)); return <section className="page"><div className="page-title"><div><h1>今日營業</h1><p>{hoursFor(today)}｜每組 100 分鐘</p></div><button className="primary" onClick={()=>setPage('reservation')}><CalendarDays size={18}/>查看預約</button></div><div className="stats"><Stat label="今日預約" value={current.length} unit="組"/><Stat label="預約人數" value={current.reduce((n,b)=>n+Number(b.party),0)} unit="人"/><Stat label="實際來店" value={arrived} unit="人"/><Stat label="未到店" value={noShow} unit="人"/></div><div className="panel"><div className="panel-title"><div><h3>今日場次</h3><p>快速查看今日預約狀態</p></div></div>{all.length?<div className="compact-list">{all.map(b=><div key={b.id}><strong>{b.name}・{b.party} 人</strong><span>{b.seats.join('、')}｜{statusText[b.status]}</span></div>)}</div>:<Empty text="今天還沒有預約"/>}</div></section>}
function Stat({label,value,unit}){return <div className="stat"><span>{label}</span><strong>{value}</strong><em>{unit}</em></div>}

function Reservations({bookings,setBookings}){
 const [date,setDate]=useState(todayString()); const sessions=sessionsFor(date); const [session,setSession]=useState(sessions[0]?.id||''); const [editing,setEditing]=useState(null)
 useEffect(()=>{const ss=sessionsFor(date); if(!ss.some(s=>s.id===session))setSession(ss[0]?.id||'')},[date])
 const list=bookings.filter(b=>b.date===date&&b.session===session); const active=list.filter(b=>!['cancelled','noshow'].includes(b.status));
 const seatBooking=id=>active.find(b=>b.seats.includes(id));
 const save=data=>{setBookings(items=>{const i=items.findIndex(x=>x.id===data.id); return i>=0?items.map(x=>x.id===data.id?data:x):[...items,data]});setEditing(null)}
 const patch=(id,status)=>setBookings(items=>items.map(b=>b.id===id?{...b,status,arrivedAt:status==='arrived'?new Date().toISOString():b.arrivedAt,lineStatus:status==='cancelled'?'cancelPending':b.lineStatus}:b))
 const remove=id=>confirm('確定刪除這筆預約？')&&setBookings(items=>items.filter(b=>b.id!==id))
 const arrived=bookings.filter(b=>b.date===date&&b.status==='arrived').reduce((n,b)=>n+Number(b.party),0); const noShow=bookings.filter(b=>b.date===date&&b.status==='noshow').reduce((n,b)=>n+Number(b.party),0)
 return <section className="page"><div className="page-title"><div><h1>預約與座位</h1><p>{hoursFor(date)}｜每組 100 分鐘</p></div><div className="actions"><input type="date" value={date} onChange={e=>setDate(e.target.value)}/><button className="primary" disabled={isClosed(date)} onClick={()=>setEditing({date,session})}><Plus size={18}/>新增預約</button></div></div>{isClosed(date)&&<div className="closed">星期二固定公休，當日不開放新增預約。</div>}<div className="stats"><Stat label="當日預約" value={bookings.filter(b=>b.date===date&&!['cancelled','noshow'].includes(b.status)).length} unit="組"/><Stat label="預約人數" value={bookings.filter(b=>b.date===date&&!['cancelled','noshow'].includes(b.status)).reduce((n,b)=>n+Number(b.party),0)} unit="人"/><Stat label="實際來店" value={arrived} unit="人"/><Stat label="未到店" value={noShow} unit="人"/></div><div className="reservation-grid"><div className="panel"><div className="panel-title"><div><h3>座位配置</h3><p>可選多張桌，但各桌保持獨立</p></div></div><div className="tabs">{sessions.map(s=><button key={s.id} className={session===s.id?'active':''} onClick={()=>setSession(s.id)}>{s.label}</button>)}</div><div className="floor"><Seat id="A1" booking={seatBooking('A1')}/><Seat id="A3" booking={seatBooking('A3')}/><Seat id="A2" booking={seatBooking('A2')}/><Seat id="A4" booking={seatBooking('A4')}/><div/><Seat id="A5" booking={seatBooking('A5')}/></div><div className="bar"><span>吧檯</span>{['吧檯1','吧檯2','吧檯3','吧檯4'].map(id=><Seat key={id} id={id} booking={seatBooking(id)} compact/>)}</div><div className="reminder">報到後 30 分鐘提醒放貓，90 分鐘提醒清場。</div></div><div className="panel"><div className="panel-title"><div><h3>本場預約</h3><p>{active.reduce((n,b)=>n+Number(b.party),0)} / 18 人</p></div></div>{list.length?<div className="booking-list">{list.map(b=><article key={b.id}><div><h4>{b.name}・{b.party} 人 {b.birthday&&'🎂'}</h4><p>{b.phone}<br/>座位：{b.seats.join('、')}</p><span className={`badge ${b.status}`}>{statusText[b.status]}</span></div><div className="booking-actions"><button onClick={()=>setEditing(b)}>編輯</button>{b.status==='booked'&&<><button onClick={()=>patch(b.id,'arrived')}>報到</button><button onClick={()=>patch(b.id,'noshow')}>未到</button></>} {b.status!=='cancelled'&&<button onClick={()=>patch(b.id,'cancelled')}>取消</button>}<button onClick={()=>remove(b.id)}>刪除</button></div></article>)}</div>:<Empty text="這個場次還沒有預約"/>}</div></div>{editing&&<BookingModal initial={editing} bookings={bookings} onClose={()=>setEditing(null)} onSave={save}/>}</section>
}
function Seat({id,booking,compact}){const def=seatDefs.find(s=>s.id===id); return <div className={`seat ${compact?'compact':''} ${booking?booking.status:''}`}><strong>{compact?id.replace('吧檯',''):id}</strong><span>{def.cap} 席{booking?`・${booking.name}`:''}</span></div>}
function BookingModal({initial,bookings,onClose,onSave}){const [form,setForm]=useState({id:initial.id||crypto.randomUUID(),date:initial.date,session:initial.session,name:initial.name||'',phone:initial.phone||'',party:initial.party||2,birthday:!!initial.birthday,status:initial.status||'booked',seats:initial.seats||[],lineStatus:initial.lineStatus||'pending',arrivedAt:initial.arrivedAt||null}); const sessions=sessionsFor(form.date); const occupied=new Set(bookings.filter(b=>b.id!==form.id&&b.date===form.date&&b.session===form.session&&!['cancelled','noshow'].includes(b.status)).flatMap(b=>b.seats)); const capacity=form.seats.reduce((n,id)=>n+(seatDefs.find(s=>s.id===id)?.cap||0),0); const update=(k,v)=>setForm(f=>({...f,[k]:v})); const submit=e=>{e.preventDefault(); if(!form.name.trim()||!form.phone.trim())return alert('請填寫姓名與電話'); if(!form.seats.length)return alert('請安排座位'); if(capacity<Number(form.party))return alert(`目前只有 ${capacity} 席，無法容納 ${form.party} 人`); onSave({...form,party:Number(form.party),arrivedAt:form.status==='arrived'?(form.arrivedAt||new Date().toISOString()):null})}; return <div className="modal-backdrop"><form className="modal" onSubmit={submit}><div className="modal-head"><div><p className="eyebrow">預約資料</p><h3>{initial.id?'編輯預約':'新增預約'}</h3></div><button type="button" onClick={onClose}>✕</button></div><div className="form-grid"><label>日期<input type="date" value={form.date} onChange={e=>{const date=e.target.value;update('date',date);update('session',sessionsFor(date)[0]?.id||'');update('seats',[])}}/></label><label>場次<select value={form.session} onChange={e=>{update('session',e.target.value);update('seats',[])}}>{sessions.map(s=><option key={s.id} value={s.id}>{s.label}</option>)}</select></label><label>姓名<input value={form.name} onChange={e=>update('name',e.target.value)}/></label><label>電話<input value={form.phone} onChange={e=>update('phone',e.target.value)}/></label><label>人數<input type="number" min="1" max="18" value={form.party} onChange={e=>update('party',e.target.value)}/></label><label>狀態<select value={form.status} onChange={e=>update('status',e.target.value)}><option value="booked">已預約</option><option value="arrived">已報到</option><option value="cancelled">已取消</option><option value="noshow">未到店</option></select></label><label className="checkbox"><input type="checkbox" checked={form.birthday} onChange={e=>update('birthday',e.target.checked)}/>本次為生日</label><div className="full"><span className="label">安排座位</span><div className="seat-picker">{seatDefs.map(s=><button type="button" key={s.id} disabled={occupied.has(s.id)} className={form.seats.includes(s.id)?'selected':''} onClick={()=>update('seats',form.seats.includes(s.id)?form.seats.filter(x=>x!==s.id):[...form.seats,s.id])}><strong>{s.id}</strong><span>{s.cap} 席</span></button>)}</div><p className="hint">已選 {form.seats.length} 個座位單位，共 {capacity} 席；本組 {form.party} 人。</p></div></div><div className="modal-foot"><button type="button" onClick={onClose}>取消</button><button className="primary">儲存預約</button></div></form></div>}
function Empty({text}){return <div className="empty">{text}</div>}
function ComingSoon({page}){return <section className="page"><div className="page-title"><div><h1>{page}</h1><p>此模組已放入正式架構，下一版接續開發。</p></div></div><div className="panel coming"><PawPrint size={42}/><h3>{page}模組準備中</h3><p>預約資料與登入架構已完成，後續可直接在同一專案擴充。</p></div></section>}

createRoot(document.getElementById('root')).render(<React.StrictMode><App/></React.StrictMode>)
